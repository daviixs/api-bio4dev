# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=api_bio4dev
POSTGRES_PORT=5432

# Prisma / App connection strings (internal service name "db")
DATABASE_URL=postgresql://postgres:postgres@db:5432/api_bio4dev
DIRECT_URL=postgresql://postgres:postgres@db:5432/api_bio4dev

# App secrets
JWT_SECRET=changeme
# opcional para compatibilidade legada
SECRETKEY=${JWT_SECRET}

# HTTP server
PORT=3000

# CORS
CORS_ORIGIN=http://localhost:3000
